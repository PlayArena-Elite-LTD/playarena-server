# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render/Database
DATABASE_URL=

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Flutterwave & Paystack Payment Gateways (Test Mode)
FLUTTERWAVE_PUBLIC_KEY=FLW_PUBLIC_KEY_your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=FLW_SECRET_KEY_your_flutterwave_secret_key_here
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret_here

# Paystack Payment Gateway (Test Mode)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Payment mode controls
PAYMENT_GATEWAY_TEST_MODE=true
BANK_PAYOUT_MODE=mock
BANK_PAYOUT_API_URL=
BANK_PAYOUT_API_KEY=
