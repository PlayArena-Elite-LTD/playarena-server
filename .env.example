# Django Settings

SECRET_KEY=your-secret-key-here

DEBUG=false

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,playarena-fw0n.onrender.com

DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://playarena-fw0n.onrender.com,https://playarenaelite.com,https://www.playarenaelite.com

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.playarenaelite.com,https://playarenaelite.com

FRONTEND_URL=https://www.playarenaelite.com



# Render/Database

DATABASE_URL=



# Email Configuration

EMAIL_HOST_USER=your-email@gmail.com

EMAIL_HOST_PASSWORD=your-app-password-here



# Payment provider (active gateway)

PAYMENT_PROVIDER=lipila



# Lipila (Zambia) — Bearer secret only, server-to-server + webhooks

LIPILA_SECRET_KEY=lsk_your_lipila_secret_key_here

LIPILA_BASE_URL=https://api.lipila.dev

LIPILA_CURRENCY=ZMW

LIPILA_WEBHOOK_SECRET=

LIPILA_WEBHOOK_URL=
LIPILA_DISBURSEMENT_CALLBACK_URL=

LIPILA_MOCK_MODE=false

# API style: legacy uses x-api-key + /api/v1/collections/

LIPILA_API_STYLE=uat
LIPILA_MOBILE_MONEY_PATH=/api/v1/collections/mobile-money
LIPILA_MOBILE_MONEY_DISBURSEMENT_PATH=/api/v1/disbursements/mobile-money
LIPILA_TIMEOUT_SECONDS=60

# ZynlePay (Sandbox). Keep credentials in environment variables, not in admin.
ZYNLE_BASE_URL=https://sandbox.zynlepay.com/zynlepay/jsonapi
ZYNLE_API_KEY=your_zynle_api_key
ZYNLE_API_ID=your_zynle_api_id
ZYNLE_MERCHANT_ID=your_zynle_merchant_id
ZYNLE_CHANNEL=momo
ZYNLE_DEPOSIT_METHOD=runBillPayment
ZYNLE_WITHDRAW_METHOD=runPayToEwallet
ZYNLE_STATUS_METHOD=checkPaymentStatus
# Generate a long random value. Register callback as:
# https://your-domain/api/payments/zynle/webhook/?token=THIS_VALUE
ZYNLE_CALLBACK_TOKEN=
ZYNLE_TIMEOUT_SECONDS=60



# Public URL for Lipila callbacks (ngrok/Render/production domain)

PUBLIC_BASE_URL=



# Payment mode controls

PAYMENT_GATEWAY_TEST_MODE=false
WALLET_AUTO_PROCESS_WITHDRAWALS=true

BANK_PAYOUT_MODE=mock

BANK_PAYOUT_API_URL=

BANK_PAYOUT_API_KEY=
