# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Render/Database
DATABASE_URL=

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Lipila Payment Gateway (sandbox: api.lipila.dev, key starts with lsk_)
LIPILA_API_KEY=lsk_your_lipila_secret_key_here
LIPILA_BASE_URL=https://api.lipila.dev
LIPILA_CURRENCY=ZMW
LIPILA_MOCK_MODE=true

# Public URL for Lipila callbacks (ngrok/Render/production domain)
PUBLIC_BASE_URL=

# Payment mode controls
PAYMENT_GATEWAY_TEST_MODE=true
BANK_PAYOUT_MODE=mock
BANK_PAYOUT_API_URL=
BANK_PAYOUT_API_KEY=
