# Copy this file to `local.env` and fill in your local secrets.
# IMPORTANT: `local.env` is gitignored (matches `*.env`). Do not commit real credentials.

# ============================================================================
# CRITICAL SECURITY SETTINGS (REQUIRED FOR PRODUCTION)
# ============================================================================

# Django Secret Key (REQUIRED)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Debug Mode (REQUIRED: Set to False in production)
# Development: DEBUG=true
# Production: DEBUG=false
DEBUG=false

# Allowed Hosts (REQUIRED for production)
# Comma-separated list of domain names
# Example: DJANGO_ALLOWED_HOSTS=lucadev.pythonanywhere.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=

# CSRF Trusted Origins (REQUIRED for production)
# Comma-separated list of HTTPS URLs
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://lucadev.pythonanywhere.com,https://www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Render PostgreSQL (preferred on Render):
# If DATABASE_URL is set, it takes precedence over DB_ENGINE/DB_* values.
DATABASE_URL=

# PostgreSQL (Production Recommended)
# For SQLite (development only), leave DB_ENGINE empty or set to 'django.db.backends.sqlite3'
# 
# To set up PostgreSQL:
# 1. Install PostgreSQL: https://www.postgresql.org/download/
# 2. Create database: CREATE DATABASE playyarena_db;
# 3. Create user: CREATE USER playyarena_user WITH PASSWORD 'your_password';
# 4. Grant privileges: GRANT ALL PRIVILEGES ON DATABASE playyarena_db TO playyarena_user;
# 5. Fill in the values below
#
# For remote PostgreSQL (AWS RDS, Heroku Postgres, etc.):
# - Set DB_HOST to your database hostname
# - Ensure DB_PORT matches your database port (usually 5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=playyarena_db
DB_USER=playyarena_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Admin Email (for error notifications)
ADMIN_EMAIL=
SERVER_EMAIL=
DEFAULT_FROM_EMAIL=

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Lipila Configuration (https://blaze-docs.lipila.dev/)
#
# OPTION 1: Mock Mode (local dev — no API key needed)
# Set LIPILA_MOCK_MODE=true — deposits auto-complete on callback
#
# OPTION 2: Sandbox — get lsk_... API key from Lipila dashboard → Wallets → API Keys
# Set LIPILA_MOCK_MODE=false and LIPILA_API_KEY=lsk_...

PAYMENT_PROVIDER=lipila
LIPILA_SECRET_KEY=
LIPILA_BASE_URL=https://api.lipila.dev
LIPILA_CURRENCY=ZMW
LIPILA_WEBHOOK_SECRET=
LIPILA_WEBHOOK_URL=
LIPILA_DISBURSEMENT_CALLBACK_URL=
LIPILA_MOCK_MODE=true
# API style: legacy uses x-api-key + /api/v1/collections/
LIPILA_API_STYLE=uat
LIPILA_MOBILE_MONEY_PATH=/api/v1/collections/mobile-money
LIPILA_MOBILE_MONEY_DISBURSEMENT_PATH=/api/v1/disbursements/mobile-money
LIPILA_TIMEOUT_SECONDS=60

# Optional: when running locally behind a tunnel, set this to your public URL
# so callback/IPN URLs are generated correctly (ngrok example):
# PUBLIC_BASE_URL=https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# Payment Gateway Test Mode
# Set to 'false' in production
PAYMENT_GATEWAY_TEST_MODE=true
WALLET_AUTO_PROCESS_WITHDRAWALS=true

# Bank payout API integration mode
# - mock: no external payout call (safe for local testing)
# - live: POST payouts to BANK_PAYOUT_API_URL
BANK_PAYOUT_MODE=mock
BANK_PAYOUT_API_URL=
BANK_PAYOUT_API_KEY=
BANK_PAYOUT_TIMEOUT_SECONDS=30

# ============================================================================
# CACHE & REDIS CONFIGURATION
# ============================================================================

# Redis (Recommended for production)
# Leave empty to use file-based or local memory cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# ============================================================================
# SSL & SECURITY (Production)
# ============================================================================

# SSL Redirect (Set to 'true' in production with HTTPS)
SECURE_SSL_REDIRECT=false

# CORS (for frontend/API integration)
# Example:
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================

# Sentry DSN (Optional but recommended for production error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# ============================================================================
# DEVELOPMENT TUNING (Optional)
# ============================================================================

# DJANGO_SQL_DEBUG=true
# DJANGO_VERBOSE_LOGGING=true
# ENABLE_TEMPLATE_KPIS=true
# PAYMENT_DEBUG=true
