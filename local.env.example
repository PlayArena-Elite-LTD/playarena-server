# Copy this file to `local.env` and fill in your local secrets.
# IMPORTANT: `local.env` is gitignored (matches `*.env`). Do not commit real credentials.

# ============================================================================
# CRITICAL SECURITY SETTINGS (REQUIRED FOR PRODUCTION)
# ============================================================================

# Django Secret Key (REQUIRED)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Debug Mode (REQUIRED: Set to False in production)
# Development: DEBUG=true
# Production: DEBUG=false
DEBUG=false

# Allowed Hosts (REQUIRED for production)
# Comma-separated list of domain names
# Example: DJANGO_ALLOWED_HOSTS=lucadev.pythonanywhere.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=

# CSRF Trusted Origins (REQUIRED for production)
# Comma-separated list of HTTPS URLs
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://lucadev.pythonanywhere.com,https://www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL (Production Recommended)
# For SQLite (development only), leave DB_ENGINE empty or set to 'django.db.backends.sqlite3'
# 
# To set up PostgreSQL:
# 1. Install PostgreSQL: https://www.postgresql.org/download/
# 2. Create database: CREATE DATABASE playyarena_db;
# 3. Create user: CREATE USER playyarena_user WITH PASSWORD 'your_password';
# 4. Grant privileges: GRANT ALL PRIVILEGES ON DATABASE playyarena_db TO playyarena_user;
# 5. Fill in the values below
#
# For remote PostgreSQL (AWS RDS, Heroku Postgres, etc.):
# - Set DB_HOST to your database hostname
# - Ensure DB_PORT matches your database port (usually 5432)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=playyarena_db
DB_USER=playyarena_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Admin Email (for error notifications)
ADMIN_EMAIL=
SERVER_EMAIL=
DEFAULT_FROM_EMAIL=

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# Pesapal (sandbox/test)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
# Optional (notification_id from Pesapal IPN registration)
PESAPAL_IPN_ID=

# Dev-only: mock Pesapal (no external calls; deposits auto-complete)
# Set to 'true' for local development without real payment gateway
PESAPAL_MOCK_MODE=

# Optional: when running locally behind a tunnel, set this to your public URL
# so callback/IPN URLs are generated correctly (ngrok example):
# PUBLIC_BASE_URL=https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=

# Payment Gateway Test Mode
# Set to 'false' in production
PAYMENT_GATEWAY_TEST_MODE=true

# ============================================================================
# CACHE & REDIS CONFIGURATION
# ============================================================================

# Redis (Recommended for production)
# Leave empty to use file-based or local memory cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# ============================================================================
# SSL & SECURITY (Production)
# ============================================================================

# SSL Redirect (Set to 'true' in production with HTTPS)
SECURE_SSL_REDIRECT=false

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================

# Sentry DSN (Optional but recommended for production error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# ============================================================================
# DEVELOPMENT TUNING (Optional)
# ============================================================================

# DJANGO_SQL_DEBUG=true
# DJANGO_VERBOSE_LOGGING=true
# ENABLE_TEMPLATE_KPIS=true
# PAYMENT_DEBUG=true

