						"url": {
							"raw": "{{base_url}}/api/disputes/?status=OPEN",
							"host": ["{{base_url}}"],
							"path": ["api", "disputes", ""],
							"query": [
								{
									"key": "status",
									"value": "OPEN",
									"description": "Filter by status: OPEN, PENDING, or RESOLVED (optional)"
								}
							]
